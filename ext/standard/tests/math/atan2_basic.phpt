--TEST--
Test atan2() - basic function test of atan2()
--INI--
serialize_precision=14
--FILE--
<?php
$valuesy = array(23,
                -23,
                2.345e1,
                -2.345e1,
                0x17,
                027,
                "23",
                "23.45",
                "2.345e1",
                );

$valuesx = array(23,
                -23,
                2.345e1,
                -2.345e1,
                0x17,
                027,
                "23",
                "23.45",
                "2.345e1",
                );

for ($i = 0; $i < count($valuesy); $i++) {
    for ($j = 0; $j < count($valuesx); $j++) {
        $res = atan2($valuesy[$i], $valuesx[$j]);
        echo "Y:$valuesy[$i] X:$valuesx[$j] ";
        var_dump($res);
    }
}
?>
